<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>dev.stxt</groupId>
    <artifactId>stxt-core</artifactId>
    <version>0.5.2</version>
    <packaging>jar</packaging>

    <!-- Metadatos exigidos por Maven Central (name, description, url, licencia,
         desarrolladores y scm). El artefacto equivalente en npm es @stxt-lang/core. -->
    <name>STXT Core</name>
    <description>Parser and schema validator for STXT, an indentation-based structured-text format.</description>
    <url>https://stxt.dev</url>
    <inceptionYear>2025</inceptionYear>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Joan Costa Mombiela</name>
            <email>joan.costa.mombiela@gmail.com</email>
            <url>https://github.com/stxt-lang</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/stxt-lang/stxt-java.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/stxt-lang/stxt-java.git</developerConnection>
        <url>https://github.com/stxt-lang/stxt-java</url>
        <tag>HEAD</tag>
    </scm>

    <issueManagement>
        <system>GitHub Issues</system>
        <url>https://github.com/stxt-lang/stxt-java/issues</url>
    </issueManagement>

    <properties>
        <!-- `release` en vez de source/target: compilamos con JDK 21 y así el compilador
             valida contra la API real de 17, no solo contra su sintaxis. -->
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- Build reproducible: fija las fechas dentro del jar. Se actualiza en cada release. -->
        <project.build.outputTimestamp>2026-07-28T00:00:00Z</project.build.outputTimestamp>
        <junit.version>5.10.0</junit.version>
        <jackson.version>2.18.0</jackson.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- BOM de Jackson para alinear versiones -->
            <dependency>
                <groupId>com.fasterxml.jackson</groupId>
                <artifactId>jackson-bom</artifactId>
                <version>${jackson.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <!-- Todas las dependencias son de test: el jar publicado no arrastra ninguna. -->
    <dependencies>
        <!-- Jackson núcleo (ObjectMapper) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Opcional: mejor soporte para constructores, records, etc. -->
        <dependency>
            <groupId>com.fasterxml.jackson.module</groupId>
            <artifactId>jackson-module-parameter-names</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Opcional: tipos de fecha/hora de Java 8+ -->
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Tests con JUnit 5 -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Plugin de compilación de Java -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!-- Plugin de tests con JUnit 5 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <useModulePath>false</useModulePath>
                </configuration>
            </plugin>

            <!-- Empaquetado. La versión va fijada para que el build no dependa de la
                 que traiga por defecto cada versión de Maven. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <!-- Nombre de módulo estable para consumidores con JPMS,
                                 mientras no haya module-info.java. -->
                            <Automatic-Module-Name>dev.stxt</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>

            <!-- Central exige el jar de fuentes junto al binario. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar-no-fork</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Central exige también el jar de javadoc. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.11.2</version>
                <executions>
                    <execution>
                        <id>attach-javadocs</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- Firma GPG solo al publicar: `mvn -Prelease ...`. Fuera de este perfil el
             build diario no necesita clave ni passphrase. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>

                    <!-- Sube el bundle firmado al Central Portal (fase deploy). `extensions`
                         es imprescindible: registra el participante de ciclo de vida que
                         desactiva el maven-deploy-plugin, que si no intentaría desplegar
                         además en un <distributionManagement> que no existe. -->
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <!-- id del <server> de ~/.m2/settings.xml que lleva el user token
                                 del Portal (no la contraseña de la cuenta). -->
                            <publishingServerId>central</publishingServerId>
                            <!-- El deploy deja el despliegue validado y *pendiente* en el
                                 Portal, para revisarlo y confirmarlo a mano desde la web. Una
                                 vez publicado en Central no se puede retirar ni sustituir. -->
                            <autoPublish>false</autoPublish>
                            <!-- Espera a que el Portal valide el bundle, para que un error de
                                 validación falle el build en vez de quedarse escondido en la
                                 web. Los tres valores posibles son UPLOADED, VALIDATED y
                                 PUBLISHED. -->
                            <waitUntil>VALIDATED</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>
