Template (@stxt.template): @stxt.schema
	Structure >>
		Schema (@stxt.schema):
			Description: (?) TEXT
			Node: (+)
				Type: (?) ENUM [INLINE, BLOCK, TEXT, GROUP, BOOLEAN, NUMBER, ENUM, INTEGER, NATURAL, DATE, TIME, TIMESTAMP, UUID, URL, EMAIL, HEXADECIMAL, BINARY, BASE64, MARKDOWN]
				Description: (?) @Description
				Values: (?) GROUP
					Value: (+)
				Children: (?) GROUP
					Child: (+)
						Min: (?) NATURAL
						Max: (?) NATURAL
